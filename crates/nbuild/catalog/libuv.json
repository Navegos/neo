{
  "name": "libuv",
  "category": "library",
  "target_level": "user",
  "description": "Multi-platform asynchronous I/O and event loop library",
  "remote_repo": "libuv/libuv",
  "releases_url": "https://api.github.com/repos/libuv/libuv/releases/latest",
  "git_url": "https://github.com/libuv/libuv.git",
  "asset_hints": {
    "windows": {
      "x86_64": ["x64.zip", "win64", "x64"],
      "aarch64": ["arm64.zip", "arm64"]
    },
    "linux": {
      "x86_64": ["tar.gz"]
    }
  },
  "env_exports": {
    "LIBUV_ROOT": ["."],
    "INCLUDE": ["include"],
    "LIB": ["lib"],
    "PATH": ["bin"]
  }
}

