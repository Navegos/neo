{
  "name": "cmake",
  "category": "tool",
  "target_level": "system",
  "description": "Cross-platform family of tools designed to build, test and package software",
  "remote_repo": "Kitware/CMake",
  "releases_url": "https://api.github.com/repos/Kitware/CMake/releases/latest",
  "git_url": "https://github.com/Kitware/CMake.git",
  "binary_subpath": "bin/cmake.exe",
  "asset_hints": {
    "windows": {
      "x86_64": ["windows-x86_64", "win64-x64"],
      "aarch64": ["windows-arm64"]
    },
    "linux": {
      "x86_64": ["linux-x86_64"],
      "aarch64": ["linux-aarch64"]
    },
    "apple": {
      "aarch64": ["macos-universal", "macos-arm64"],
      "x86_64": ["macos-universal", "macos-x86_64"]
    }
  },
  "env_exports": {
    "PATH": ["bin"]
  }
}
