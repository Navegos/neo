{
  "name": "ninja",
  "category": "tool",
  "target_level": "system",
  "description": "Small build system with a focus on speed",
  "remote_repo": "ninja-build/ninja",
  "releases_url": "https://api.github.com/repos/ninja-build/ninja/releases/latest",
  "git_url": "https://github.com/ninja-build/ninja.git",
  "binary_subpath": "bin/ninja.exe",
  "asset_hints": {
    "windows": {
      "x86_64": ["ninja-win"]
    },
    "linux": {
      "x86_64": ["ninja-linux"],
      "aarch64": ["ninja-linux-aarch64"]
    },
    "apple": {
      "aarch64": ["ninja-mac"],
      "x86_64": ["ninja-mac"]
    }
  },
  "env_exports": {
    "PATH": ["bin"]
  }
}
