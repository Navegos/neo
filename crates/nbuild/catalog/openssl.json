{
  "name": "openssl",
  "category": "library",
  "target_level": "user",
  "description": "Robust, commercial-grade, full-featured OpenSSL toolkit for TLS and cryptography",
  "remote_repo": "openssl/openssl",
  "releases_url": "https://api.github.com/repos/openssl/openssl/releases/latest",
  "git_url": "https://github.com/openssl/openssl.git",
  "asset_hints": {
    "windows": {
      "x86_64": ["openssl", "win64", "x64"],
      "aarch64": ["openssl", "arm64", "win-arm64"]
    },
    "linux": {
      "x86_64": ["openssl", "linux-x86_64"],
      "aarch64": ["openssl", "linux-aarch64"]
    },
    "apple": {
      "aarch64": ["openssl", "macos-arm64"],
      "x86_64": ["openssl", "macos-x86_64"]
    }
  },
  "dependencies": ["zlib"],
  "env_exports": {
    "OPENSSL_ROOT_DIR": ["."],
    "INCLUDE": ["include"],
    "LIB": ["lib"],
    "PATH": ["bin"]
  }
}

