{
  "name": "vcpkg",
  "category": "tool",
  "target_level": "system",
  "description": "C/C++ library package manager from Microsoft",
  "remote_repo": "microsoft/vcpkg-tool",
  "releases_url": "https://api.github.com/repos/microsoft/vcpkg-tool/releases/latest",
  "git_url": "https://github.com/microsoft/vcpkg.git",
  "binary_subpath": "bin/vcpkg.exe",
  "asset_hints": {
    "windows": {
      "x86_64": ["vcpkg.exe"],
      "aarch64": ["vcpkg-arm64.exe"]
    },
    "linux": {
      "x86_64": ["vcpkg-glibc"],
      "aarch64": ["vcpkg-glibc-arm64"]
    },
    "apple": {
      "aarch64": ["vcpkg-macos"],
      "x86_64": ["vcpkg-macos"]
    }
  },
  "env_exports": {
    "VCPKG_ROOT": ["."],
    "PATH": ["bin"]
  }
}

