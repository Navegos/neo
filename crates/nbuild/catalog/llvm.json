{
  "name": "llvm",
  "category": "compiler",
  "target_level": "system",
  "description": "LLVM compiler infrastructure and Clang C/C++ toolchain",
  "remote_repo": "llvm/llvm-project",
  "releases_url": "https://api.github.com/repos/llvm/llvm-project/releases/latest",
  "git_url": "https://github.com/llvm/llvm-project.git",
  "binary_subpath": "bin/clang.exe",
  "asset_hints": {
    "windows": {
      "x86_64": ["x86_64-pc-windows-msvc", "LLVM-", "-win64"]
    },
    "linux": {
      "x86_64": ["x86_64-linux-gnu"],
      "aarch64": ["aarch64-linux-gnu"]
    },
    "apple": {
      "x86_64": ["x86_64-apple-darwin"],
      "aarch64": ["arm64-apple-darwin", "macos"]
    }
  },
  "env_exports": {
    "PATH": ["bin"],
    "CC": ["bin/clang.exe"],
    "CXX": ["bin/clang++.exe"],
    "LLVM_ROOT": ["."]
  }
}

